{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProceduralGraphReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "version",
    "ontology_version",
    "entry_node",
    "metadata",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "type": "string"
    },
    "entry_node": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "action",
              "decision",
              "state",
              "terminal"
            ]
          },
          "label": {
            "type": "string"
          },
          "action_ref": {
            "type": "string"
          },
          "state_ref": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "action_ref"
            ],
            "not": {
              "required": [
                "state_ref"
              ]
            }
          },
          {
            "required": [
              "state_ref"
            ],
            "not": {
              "required": [
                "action_ref"
              ]
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "relation",
          "target",
          "condition",
          "guidance",
          "pitfalls",
          "predicate_id",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relation": {
            "const": "LEADS_TO"
          },
          "condition": {
            "type": "string",
            "maxLength": 800
          },
          "guidance": {
            "type": "string",
            "maxLength": 1200
          },
          "pitfalls": {
            "type": "string",
            "maxLength": 1000
          },
          "predicate_id": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    }
  }
}
