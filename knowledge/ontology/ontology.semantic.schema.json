  "required": [
    "schema_version",
    "semantic_schema_version",
    "ontology_id",
    "version",
    "status",
    "upstream_commit",
    "scope",
    "identity_key",
    "value_statuses",
    "change_statuses",
    "entities",
    "relations",
    "actions",
    "states",
    "properties",
    "check_catalog",
    "invariants",
    "restock_formula"
  ],
  "title": "SemanticOntology",
  "type": "object"
}
